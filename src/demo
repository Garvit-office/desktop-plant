export default App;            /* Ensure absolute background transparency for the Tauri desktop window */
body, html, #root {
  background: transparent !important;
  margin: 0;
  padding: 0;
  overflow: hidden;
  width: 100vw;
  height: 100vh;
}

.screen-overlay-root {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: transparent;
  pointer-events: none; /* Allows click-through across transparent desktop areas */
}

/* Anchored seamlessly to the top-right frame corner */
.vine-container {
  position: absolute;
  top: 0;
  right: 25px;
  width: 180px;
  height: 350px;
  pointer-events: auto; /* Enables dragging and hover states */
  cursor: grab;
  transform-origin: top center;
  animation: realisticBreeze 8s ease-in-out infinite;
}

.vine-container:active {
  cursor: grabbing;
}

/* Photorealistic Depth & Drop Shadow to mimic a real item hanging off screen bezels */
.realistic-vine-svg {
  width: 100%;
  height: 100%;
  filter: drop-shadow(6px 14px 10px rgba(0, 0, 0, 0.45));
}

/* Natural Organic Wind Simulation */
@keyframes realisticBreeze {
  0% { transform: rotate(0deg) skewX(0deg); }
  25% { transform: rotate(0.8deg) skewX(0.3deg); }
  50% { transform: rotate(0deg) skewX(0deg); }
  75% { transform: rotate(-0.7deg) skewX(-0.2deg); }
  100% { transform: rotate(0deg) skewX(0deg); }
}

@media (prefers-reduced-motion: reduce) {
  .vine-container {
    animation: none;
  }
}